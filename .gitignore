*.TmpPCB
*.PrjPCBStructure
*.PrjPcbSettings
*.DsnWrk
*.log
*.bak
*.~*
*.tmp
*.ddb

# Output folders and generated files
OutputJob/*.OutJob
__Previews/
Project Outputs for */*
Project Logs for */*

